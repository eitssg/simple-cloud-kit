{
    "yaml.customTags": [
        "!Ref", "!GetAtt", "!Sub", "!Join", "!Select", "!Split",
        "!Base64", "!If", "!Equals", "!And", "!Or", "!Not",
        "!FindInMap", "!ImportValue", "!Condition", "!Transform"
    ],
    "files.associations": {
        "**/platform/components/*.yaml": "yaml"
    },
    "yaml.schemas": {
        "https://raw.githubusercontent.com/awslabs/goformation/master/schema/cloudformation.schema.json": [
            "**/platform/components/*.yaml",
            "cloudformation*.yaml",
            "*.cfn.yaml"
        ]
    },
    "iis.configDir": "",
    "xxfiles.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.venv": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
       "sck-core-*/": true
    },
    "xxsearch.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/dist": true,
        "**/build": true,
        "**/.vscode": true,
        "**'.venv": true,
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/.DS_Store": true,
        "**/Thumbs.db": true,
       "sck-core-*/": true
    },
    "xxfiles.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/.hg/store/**": true,
        "**/.venv/**": true,
        "**/node_modules/**": true,
        "**/bower_components/**": true,
        "**/dist/**": true,
        "**/build/**": true,
       "sck-core-*/": true
    },
    "python.testing.pytestArgs": [
        "."
    ],
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": true,
    "editor.defaultFormatter": "ms-python.black-formatter",
    "python-envs.pythonProjects": [
        {
            "path": "",
            "envManager": "ms-python.python:venv",
            "packageManager": "ms-python.python:pip"
        }
    ]
}